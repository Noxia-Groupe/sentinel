# =============================================
# SENTINEL — Configuration
# Copier ce fichier en .env et remplir les valeurs
# =============================================

# --- Base de données PostgreSQL ---
# Pour Docker, le host est "sentinel-db" (nom du service dans docker-compose)
DATABASE_URL="postgresql://sentinel:CHANGE_ME@sentinel-db:5432/sentinel"
DB_PASSWORD="CHANGE_ME"

# --- Chiffrement AES-256-GCM ---
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME"

# --- NextAuth.js ---
NEXTAUTH_URL="https://sentinel.noxia-groupe.fr"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
AUTH_TRUST_HOST=true

# Microsoft Entra ID (Azure AD) - tenant Noxia-Groupe
# Application à créer sur https://portal.azure.com → Microsoft Entra ID → Inscriptions d'applications
#   Type : Web (pas SPA)
#   Redirect URI : https://sentinel.noxia-groupe.fr/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID="CHANGE_ME"              # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET="CHANGE_ME"           # Client secret (Value, pas Secret ID)
# ATTENTION : PAS de slash final — Entra ID publie son issuer sans slash et la
# validation OIDC compare les deux chaînes à l'identique.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/TENANT_ID/v2.0"
#                                                           ^^^^^^^^^ REMPLACER par ton Directory (tenant) ID
# Laisser vide pour autoriser n'importe quel compte Microsoft (tenant "common").

# --- Superadmins (emails séparés par des virgules) ---
# Seuls les superadmins gèrent les clés d'API et consultent le journal d'audit.
ADMIN_EMAILS="nelson@noxia-groupe.fr"

# =============================================
# Réglages optionnels (valeurs par défaut indiquées)
# =============================================

# --- Dialogue avec les enregistreurs Dahua ---
# Délai maximum d'un appel à l'API CGI d'un NVR, en millisecondes.
# DAHUA_TIMEOUT_MS=8000

# --- Accès aux enregistreurs déclarés en P2P (sans IP joignable) ---
# L'utilitaire `dh-p2p` embarqué dans l'image ouvre un tunnel vers l'équipement
# à partir de son seul numéro de série, via le cloud Dahua. Rien à configurer :
# le défaut ci-dessous s'applique automatiquement.
#
# Ne surcharger DAHUA_P2P_HELPER que pour pointer un autre utilitaire.
# Substitutions : {serial} {host} {port} (port local ouvert) {devicePort}.
# Les identifiants sont aussi exposés dans l'environnement de l'utilitaire
# (DAHUA_P2P_USERNAME / DAHUA_P2P_PASSWORD), jamais en arguments.
# Une valeur VIDE désactive le P2P (les alarmes par webhook continuent d'arriver).
# DAHUA_P2P_HELPER="/usr/local/bin/dh-p2p --port {host}:{port}:{devicePort} {serial}"
#
# Fermeture du tunnel après inactivité, délai d'établissement, et motif imprimé
# par l'utilitaire quand le tunnel est prêt (attendu avant d'émettre les requêtes).
# DAHUA_P2P_IDLE_MS=120000
# DAHUA_P2P_READY_TIMEOUT_MS=20000
# DAHUA_P2P_READY_PATTERN="Ready to connect"
#
# Le cloud Dahua répond depuis plusieurs serveurs (tourniquet DNS) et dh-p2p
# n'en interroge qu'un, sans réessayer : si ce nœud ne répond pas, il s'arrête.
# On relance donc l'établissement plusieurs fois — chaque essai peut viser un
# autre serveur. Monter CONNECT_ATTEMPTS si un site tombe souvent sur un nœud lent.
# DAHUA_P2P_CONNECT_ATTEMPTS=3
# DAHUA_P2P_RETRY_DELAY_MS=800

# --- Adresse déclarée aux enregistreurs comme centre d'alarme ---
# Par défaut, SENTINEL provisionne les NVR avec NEXTAUTH_URL (donc en HTTPS).
# Ne renseigner ALARM_CENTER_URL que si les enregistreurs joignent la
# plateforme par une autre adresse que son nom d'hôte public — par exemple une
# adresse interne de VPN. Le HTTPS n'est à abandonner que pour un firmware
# ancien incapable de négocier TLS (choix possible par NVR dans l'interface).
# ALARM_CENTER_URL="https://sentinel.noxia-groupe.fr"

# --- Réception des alarmes ---
# Fenêtre de regroupement des alarmes identiques non traitées, en secondes.
# Sans elle, une détection de mouvement répétée noie le centre d'alarme.
# Mettre 0 pour enregistrer chaque notification telle quelle.
# DAHUA_DEDUPE_WINDOW_SECONDS=60

# --- API des agents (/api/v1) ---
# Limitation de débit appliquée par clé d'API.
# API_RATE_LIMIT=120
# API_RATE_WINDOW_MS=60000
