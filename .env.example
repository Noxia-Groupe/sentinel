# =============================================
# SENTINEL — Configuration
# Copier ce fichier en .env et remplir les valeurs
# =============================================

# --- Base de données PostgreSQL ---
# Pour Docker, le host est "sentinel-db" (nom du service dans docker-compose)
DATABASE_URL="postgresql://sentinel:CHANGE_ME@sentinel-db:5432/sentinel"
DB_PASSWORD="CHANGE_ME"

# --- Chiffrement AES-256-GCM ---
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME"

# --- NextAuth.js ---
NEXTAUTH_URL="https://sentinel.noxia-groupe.fr"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
AUTH_TRUST_HOST=true

# Microsoft Entra ID (Azure AD) - tenant Noxia-Groupe
# Application à créer sur https://portal.azure.com → Microsoft Entra ID → Inscriptions d'applications
#   Type : Web (pas SPA)
#   Redirect URI : https://sentinel.noxia-groupe.fr/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID="CHANGE_ME"              # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET="CHANGE_ME"           # Client secret (Value, pas Secret ID)
# ATTENTION : PAS de slash final — Entra ID publie son issuer sans slash et la
# validation OIDC compare les deux chaînes à l'identique.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/TENANT_ID/v2.0"
#                                                           ^^^^^^^^^ REMPLACER par ton Directory (tenant) ID
# Laisser vide pour autoriser n'importe quel compte Microsoft (tenant "common").

# --- Superadmins d'office (emails séparés par des virgules) ---
# Amorçage de la plateforme : ces adresses sont toujours superadmins et ne sont
# pas modifiables depuis l'interface. Les autres comptes sont autorisés, bannis
# et promus depuis Paramètres → Accès à la plateforme (réservé aux superadmins).
ADMIN_EMAILS="nelson@noxia-groupe.fr"

# =============================================
# Réglages optionnels (valeurs par défaut indiquées)
# =============================================

# --- Dialogue avec les enregistreurs Dahua ---
# Délai maximum d'un appel à l'API CGI d'un NVR, en millisecondes.
# DAHUA_TIMEOUT_MS=8000
#
# Fuseau horaire des enregistreurs : « Mettre à l'heure » y écrit l'heure légale,
# changements d'heure été/hiver compris, quel que soit le fuseau du serveur.
# DAHUA_TIME_ZONE="Europe/Paris"
#
# Fuseau du conteneur (journaux, affichage serveur). Les dates restent en UTC en base.
# TZ="Europe/Paris"

# --- Accès aux enregistreurs déclarés en P2P (sans IP joignable) ---
# L'utilitaire `dh-fwd` embarqué dans l'image ouvre un tunnel vers l'équipement
# à partir de son seul numéro de série, via le cloud Dahua. Il gère les
# firmwares postérieurs à 2024.07 (canal authentifié, dialecte DMSS/SmartPSS).
# Rien à configurer : les défauts ci-dessous s'appliquent automatiquement.
#
# Ne surcharger DAHUA_P2P_HELPER que pour pointer un autre utilitaire.
# Substitutions : {serial} {port} (port local ouvert) {devicePort}.
# Les identifiants sont exposés dans l'environnement de l'utilitaire
# (DAHUA_P2P_USERNAME / DAHUA_P2P_PASSWORD), jamais en arguments.
# Une valeur VIDE désactive le P2P (les alarmes par webhook continuent d'arriver).
# DAHUA_P2P_HELPER="/usr/local/bin/dh-fwd {serial} -p {port}:{devicePort}"
#
# Profil applicatif : reproduit le dialecte du client officiel Dahua.
#   smartpss (défaut) — équipement enregistré via SmartPSS (cloud easy4ip).
#   dmss              — équipement enrôlé via l'application DMSS (cloud Dolynk).
# C'est le profil essayé EN PREMIER : si le cloud répond 404 (mauvais cloud),
# SENTINEL bascule automatiquement sur l'autre et retient, par NVR, celui qui
# a fonctionné. Ne le changer que si la majorité du parc est côté DMSS.
# DAHUA_P2P_PROFILE=smartpss
#
# Fermeture du tunnel après inactivité, délai d'établissement, et motif imprimé
# par l'utilitaire quand le tunnel est prêt (attendu avant d'émettre les requêtes).
# DAHUA_P2P_IDLE_MS=120000
# DAHUA_P2P_READY_TIMEOUT_MS=20000
# DAHUA_P2P_READY_PATTERN="Listening on"
#
# Le cloud Dahua répond depuis plusieurs serveurs (tourniquet DNS). Si un nœud
# ne répond pas, on relance l'établissement plusieurs fois — chaque essai peut
# viser un autre serveur. Monter CONNECT_ATTEMPTS si un site tombe souvent sur
# un nœud lent.
# DAHUA_P2P_CONNECT_ATTEMPTS=3
# DAHUA_P2P_RETRY_DELAY_MS=800
#
# Mode relais : le trafic passe par le serveur relais Dahua au lieu d'une
# connexion directe à l'équipement. Nécessaire derrière un NAT qui bloque la
# connexion directe (le tunnel direct ne s'établit alors jamais). Plus lent,
# mais robuste — adapté à la maintenance (requêtes courtes).
# DAHUA_P2P_RELAY=1

# --- Adresse déclarée aux enregistreurs comme centre d'alarme ---
# Par défaut, SENTINEL provisionne les NVR avec NEXTAUTH_URL (donc en HTTPS).
# Ne renseigner ALARM_CENTER_URL que si les enregistreurs joignent la
# plateforme par une autre adresse que son nom d'hôte public — par exemple une
# adresse interne de VPN. Le HTTPS n'est à abandonner que pour un firmware
# ancien incapable de négocier TLS (choix possible par NVR dans l'interface).
# ALARM_CENTER_URL="https://sentinel.noxia-groupe.fr"

# --- Supervision permanente ---
# Réglée depuis Paramètres → Supervision permanente (intervalle, seuils).
# Mettre à 1 pour ne pas démarrer du tout l'horloge de supervision sur cette
# instance (instance de test, par exemple).
# SUPERVISION_DISABLED=1

# --- Réception des alarmes ---
# Fenêtre de regroupement des alarmes identiques non traitées, en secondes.
# Sans elle, une détection de mouvement répétée noie le centre d'alarme.
# Mettre 0 pour enregistrer chaque notification telle quelle.
# DAHUA_DEDUPE_WINDOW_SECONDS=60

# --- API des agents (/api/v1) ---
# Limitation de débit appliquée par clé d'API.
# API_RATE_LIMIT=120
# API_RATE_WINDOW_MS=60000

# --- Direct vidéo (une caméra à la fois, flux secondaire) ---
# Le serveur lit le flux RTSP secondaire (subtype=1) de la voie choisie et le
# retransmet en MJPEG allégé. ffmpeg est installé dans l'image Docker.
# FFMPEG_PATH=ffmpeg
# Nombre maximal de directs simultanés sur toute l'instance.
# LIVE_MAX_STREAMS=3
# Coupure automatique d'un direct au bout de N minutes.
# LIVE_MAX_MINUTES=10
# Images par seconde envoyées au navigateur (1 à 15).
# LIVE_FPS=6
# Qualité JPEG : 2 (meilleure, plus lourde) à 31 (plus légère).
# LIVE_QUALITY=8
