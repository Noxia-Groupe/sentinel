# =============================================
# SENTINEL — Fichier de configuration
# Copier en .env et remplir les valeurs
# =============================================

# Base de données PostgreSQL (pour Docker, le host est "sentinel-db")
DATABASE_URL="postgresql://sentinel:CHANGE_ME@sentinel-db:5432/sentinel"
DB_PASSWORD="CHANGE_ME"

# Clé de chiffrement AES-256-GCM (générer avec: openssl rand -base64 32)
ENCRYPTION_KEY="CHANGE_ME"

# NextAuth.js
NEXTAUTH_URL="https://sentinel.noxia-groupe.fr"
NEXTAUTH_SECRET="CHANGE_ME"

# Microsoft Entra ID (Azure AD) - tenant Noxia-Groupe
AUTH_MICROSOFT_ENTRA_ID_ID="CHANGE_ME"
AUTH_MICROSOFT_ENTRA_ID_SECRET="CHANGE_ME"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/TENANT_ID/v2.0/"
