generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Utilisateurs via NextAuth / Microsoft Entra ID
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Historique : le rôle effectif vient désormais de AccessEntry / ADMIN_EMAILS
  // (voir src/lib/access.ts). Colonne conservée pour ne rien casser en base.
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apiKeys           ApiKey[]
  acknowledgedEvents NvrEvent[]     @relation("EventAcknowledgedBy")
  resolvedEvents     NvrEvent[]     @relation("EventResolvedBy")
  assignedEvents     NvrEvent[]     @relation("EventAssignedTo")
  eventComments      EventComment[]
}

// Liste d'accès à la plateforme, gérée par les superadmins.
//
// Une connexion Microsoft valide ne suffit pas : seule une adresse présente ici
// avec le statut "authorized" (ou déclarée dans ADMIN_EMAILS) ouvre l'accès.
// Une tentative de connexion d'une adresse inconnue crée une entrée "pending"
// que le superadmin peut autoriser ou bannir en un clic.
model AccessEntry {
  id            String    @id @default(cuid())
  email         String    @unique // toujours en minuscules
  name          String?
  role          String    @default("user") // "user" | "superadmin"
  status        String    @default("pending") // "authorized" | "banned" | "pending"
  note          String?
  addedBy       String?
  lastLoginAt   DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Client final : le parc de chaque client est regroupé sous une fiche
model Client {
  id           String   @id @default(cuid())
  name         String
  // Référence interne (code dossier, code chantier…)
  code         String?  @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nvrs Nvr[]

  @@index([name])
}

// Enregistreur NVR Dahua
model Nvr {
  id             String  @id @default(cuid())
  name           String
  clientId       String?
  client         Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ip             String?
  // Port du SDK privé Dahua (37777) — utilisé par SmartPSS / DMSS
  port           Int     @default(37777)
  // Port de l'interface web / API CGI : c'est celui qu'utilise SENTINEL
  httpPort       Int     @default(80)
  // true = l'API CGI est jointe en HTTPS (certificat auto-signé accepté)
  useHttps       Boolean @default(false)
  serialNumber   String? @unique
  model          String?
  firmware       String?
  location       String?
  notes          String?
  // Mode de connexion : "ip" = direct IP, "p2p" = Dahua P2P
  connectionMode String  @default("ip")
  // Identifiant P2P (généralement le SN, ex: 5H02A12PAX00001)
  p2pSerial      String?
  status         String  @default("unknown")

  lastSeen         DateTime?
  // Dernier test de connexion effectué depuis SENTINEL
  lastCheckAt      DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?

  webhookToken String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  credentials NvrCredential[]
  events      NvrEvent[]
  checks      ConnectionCheck[]

  @@index([clientId])
  @@index([status])
}

// Credentials chiffrés pour accès NVR
model NvrCredential {
  id                String  @id @default(cuid())
  nvrId             String
  nvr               Nvr     @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  // "admin" | "telesurveilleur" | "installateur" | "client" | "technicien"
  type              String
  label             String?
  username          String // Nom d'utilisateur (stocké en clair)
  encryptedPassword String // Mot de passe chiffré AES-256-GCM

  // Résultat du dernier test effectué avec ce compte
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  // Droits constatés sur l'équipement lors du dernier test (groupe, autorités…)
  rights       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checks ConnectionCheck[]

  // Un même NVR peut porter plusieurs comptes du même type (deux télésurveilleurs
  // par exemple) : c'est le couple type + identifiant qui doit être unique.
  @@unique([nvrId, type, username])
}

// Événements reçus des NVR (Alarm Center) et traités depuis la plateforme
model NvrEvent {
  id      String @id @default(cuid())
  nvrId   String
  nvr     Nvr    @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  type    String // Type d'événement normalisé (VideoMotion, VideoLoss, …)
  title   String? // Libellé lisible calculé à la réception
  code    String? // Code brut renvoyé par l'équipement
  channel Int? // Canal / caméra concerné
  payload Json // Payload complet de l'événement

  // "critical" | "major" | "minor" | "info"
  severity String @default("info")
  // "new" | "acknowledged" | "in_progress" | "resolved" | "ignored"
  status   String @default("new")
  // "webhook" | "manual" | "poll"
  source   String @default("webhook")

  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("EventAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  // Renseigné quand le traitement vient d'une clé API (agent IA)
  acknowledgedByKey String?

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("EventResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String?

  assignedToId String?
  assignedTo   User?   @relation("EventAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now())

  comments EventComment[]

  @@index([nvrId, receivedAt])
  @@index([status, receivedAt])
  @@index([severity, receivedAt])
  @@index([receivedAt])
}

// Main courante d'un événement
model EventComment {
  id      String   @id @default(cuid())
  eventId String
  event   NvrEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId    String?
  author      User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Nom affiché quand l'auteur est une clé API (agent IA) ou le système
  authorLabel String?

  body      String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

// Historique des tests de connexion / vérifications de droits
model ConnectionCheck {
  id           String         @id @default(cuid())
  nvrId        String
  nvr          Nvr            @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  credentialId String?
  credential   NvrCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  success   Boolean
  latencyMs Int?
  message   String?
  // Infos remontées par l'équipement (modèle, firmware, SN…)
  device    Json?
  // Droits du compte testé (groupe, liste d'autorités…)
  rights    Json?

  // "user" | "apikey" | "system"
  actorType  String  @default("user")
  actorId    String?
  actorLabel String?

  createdAt DateTime @default(now())

  @@index([nvrId, createdAt])
}

// Clés d'API pour les intégrations et agents IA
model ApiKey {
  id     String @id @default(cuid())
  name   String
  // Préfixe public affiché dans l'interface (les 12 premiers caractères)
  prefix String @unique
  // SHA-256 du secret complet — le secret en clair n'est jamais stocké
  hash   String @unique

  // Ex: ["alarms:read", "alarms:write", "nvr:read", "nvr:test",
  //      "nvr:control", "credentials:read"]
  scopes String[]

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([revokedAt])
}

// Journal d'audit : toute action sensible (lecture d'un mot de passe, test de
// connexion, action distante, traitement d'alarme) y est tracée.
model AuditLog {
  id String @id @default(cuid())

  // "user" | "apikey" | "system"
  actorType  String
  actorId    String?
  actorLabel String?

  action     String // "credential.reveal", "nvr.reboot", "event.acknowledge"…
  targetType String? // "nvr" | "event" | "credential" | "client" | "apikey"
  targetId   String?
  success    Boolean @default(true)
  metadata   Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
}

// Webhooks sortants : Sentinel pousse les alarmes et pannes choisies vers un
// service externe (typiquement un agent Hermes). Chaque envoi est signé
// (HMAC-SHA256) avec un secret propre au webhook, chiffré en base.
model WebhookEndpoint {
  id              String   @id @default(cuid())
  name            String
  url             String
  secretEncrypted String
  enabled         Boolean  @default(true)

  // Filtres — un tableau vide signifie « tout ».
  severities  String[] // "critical" | "major" | "minor" | "info"
  categories  String[] // intrusion | video | io | storage | system | other
  clientIds   String[]
  // Types d'événements envoyés en plus des nouvelles alarmes.
  notifyStatusChanges Boolean @default(false) // alarm.status_changed
  notifyNvrStatus     Boolean @default(true) // nvr.offline / nvr.online

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType  String // alarm.created, alarm.status_changed, nvr.offline, nvr.online, sentinel.test
  payload    Json
  // "pending" | "success" | "failed"
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastStatus    Int?
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}
