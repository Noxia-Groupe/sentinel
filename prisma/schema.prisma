generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Utilisateurs via NextAuth / Microsoft Entra ID
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "admin" | "user"
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Enregistreur NVR Dahua
model Nvr {
  id             String         @id @default(cuid())
  name           String
  ip             String?
  port           Int            @default(37777)
  serialNumber   String?        @unique
  model          String?
  location       String?
  notes          String?
  // Mode de connexion : "ip" = direct IP, "p2p" = Dahua P2P
  connectionMode String         @default("ip")
  // Identifiant P2P (généralement le SN, ex: 5H02A12PAX00001)
  p2pSerial      String?
  status         String         @default("unknown")
  lastSeen       DateTime?
  webhookToken   String         @unique @default(cuid())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  credentials    NvrCredential[]
  events         NvrEvent[]
}

// Credentials chiffrés pour accès NVR
model NvrCredential {
  id              String   @id @default(cuid())
  nvrId           String
  nvr             Nvr      @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  type            String   // "admin" | "telesurveilleur"
  username        String   // Nom d'utilisateur (stocké en clair)
  encryptedPassword String // Mot de passe chiffré AES-256-GCM (Base64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([nvrId, type])
}

// Événements reçus des NVR via Alarm Center
model NvrEvent {
  id        String   @id @default(cuid())
  nvrId     String
  nvr       Nvr      @relation(fields: [nvrId], references: [id], onDelete: Cascade)
  type      String   // Type d'événement (alarm, motion, disk_error, etc.)
  payload   Json     // Payload complet de l'événement
  receivedAt DateTime @default(now())

  @@index([nvrId, receivedAt])
}
